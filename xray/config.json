{
  "log": {
    "loglevel": "debug"
  },
  "inbounds": [
    {
      "port": 8443,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "6dce7d51-9719-46f1-8707-6bc5d892a76d",
            "flow": "xtls-rprx-direct",
            "level": 0
          }
        ],
        "decryption": "none",
        "fallbacks": [
          {
            "dest": 1310,
            "xver": 1
          },
          {
            "path": "/misaka_vless_ws", // 必须换成自定义的 PATH
            "dest": 1234,
            "xver": 1
          },
          {
            "path": "/misaka_vmess_ws", // 必须换成自定义的 PATH
            "dest": 3456,
            "xver": 1
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "xtls",
        "xtlsSettings": {
          "alpn": [
            "http/1.1"
          ],
          "certificates": [
            {
              "certificateFile": "/caddy/data/caddy/certificates/acme.zerossl.com-v2-dv90/chuxubank.top/chuxubank.top.crt", // 换成你的证书，绝对路径
              "keyFile": "/caddy/data/caddy/certificates/acme.zerossl.com-v2-dv90/chuxubank.top/chuxubank.top.key" // 换成你的私钥，绝对路径
            }
          ]
        }
      }
    },
    {
      "port": 1310,
      "listen": "127.0.0.1",
      "protocol": "trojan",
      "settings": {
        "clients": [
          {
            "password": "hello", // 填写你的密码
            "level": 0
          }
        ],
        "fallbacks": [
          {
            "dest": "caddy:80" // 或者回落到其它也防探测的代理
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "none",
        "tcpSettings": {
          "acceptProxyProtocol": true
        }
      }
    },
    {
      "port": 1234,
      "listen": "127.0.0.1",
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "30490e90-2f1e-48c9-a33e-04aaf13fa431", // 填写你的 UUID
            "level": 0
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "ws",
        "security": "none",
        "wsSettings": {
          "acceptProxyProtocol": true, // 提醒：若你用 Nginx/Caddy 等反代 WS，需要删掉这行
          "path": "/misaka_vless_ws" // 必须换成自定义的 PATH，需要和分流的一致
        }
      }
    },
    {
      "port": 3456,
      "listen": "127.0.0.1",
      "protocol": "vmess",
      "settings": {
        "clients": [
          {
            "id": "30490e90-2f1e-48c9-a33e-04aaf13fa431", // 填写你的 UUID
            "level": 0
          }
        ]
      },
      "streamSettings": {
        "network": "ws",
        "security": "none",
        "wsSettings": {
          "acceptProxyProtocol": true, // 提醒：若你用 Nginx/Caddy 等反代 WS，需要删掉这行
          "path": "/misaka_vmess_ws" // 必须换成自定义的 PATH，需要和分流的一致
        }
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "freedom"
    }
  ]
}