<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>KeepAlive</key>
	<true/>
	<key>Label</key>
	<string>homebrew.mxcl.xray</string>
    <key>StandardOutPath</key>
    <string>/Users/xuchu1/Library/Logs/Xray/stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/xuchu1/Library/Logs/Xray/stderr.log</string>
	<key>LimitLoadToSessionType</key>
	<array>
		<string>Aqua</string>
		<string>Background</string>
		<string>LoginWindow</string>
		<string>StandardIO</string>
		<string>System</string>
	</array>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/opt/xray/bin/xray</string>
		<string>run</string>
		<string>-confdir</string>
		<string>/usr/local/etc/xray/reverse</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
</dict>
</plist>
