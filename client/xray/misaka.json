{
  "log": {
    "loglevel": "debug",
    "dnsLog": true
  },
  "dns": {
    "servers": [
      {
        "address": "223.5.5.5",
        "port": 53,
        "domains": ["geosite:cn"],
        "expectIPs": ["geoip:cn"]
      },
      {
        "address": "8.8.8.8",
        "port": 53,
        "domains": ["geosite:geolocation-!cn"]
      },
      "1.1.1.1",
      "localhost"
    ],
    "queryStrategy": "UseIPv4"
  },
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "type": "field",
        "outboundTag": "Direct",
        "domain": ["geosite:umeng"]
      },
      {
        "type": "field",
        "outboundTag": "Block",
        "domain": ["geosite:category-ads", "domain:zscloud.net"]
      },
      {
        "type": "field",
        "outboundTag": "Proxy-grpc",
        "domain": ["geosite:bing"]
      },
      {
        "type": "field",
        "outboundTag": "Direct",
        "domain": [
          "geosite:cn",
          "geosite:google@cn",
          "geosite:apple",
          "geosite:jetbrains",
          "geosite:microsoft@cn",
          "geosite:notion",
          "geosite:logitech",
          "domain:teams.microsoft.com",
          "domain:documentfoundation.org",
          "domain:cn.msi.com",
          "domain:ping.pe",
          "domain:bwh88.net",
          "domain:64clouds.com",
          "domain:justmysocks5.net",
          "domain:imwork.net",
          "full:direct.chuxubank.top"
        ]
      },
      {
        "type": "field",
        "outboundTag": "Proxy-grpc",
        "domain": ["geosite:geolocation-!cn"]
      },
      {
        "type": "field",
        "outboundTag": "Direct",
        "ip": ["geoip:cn", "geoip:private"]
      }
    ]
  },
  "inbounds": [
    {
      "port": 10800,
      "listen": "127.0.0.1",
      "protocol": "socks",
      "settings": {
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls"]
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "chuxubank.top",
            "port": 443,
            "users": [
              {
                "id": "be9f4d8c-bdcf-3bea-564e-738a370c1eb1",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "tag": "Proxy-grpc",
      "streamSettings": {
        "network": "grpc",
        "security": "tls",
        "grpcSettings": {
          "serviceName": "listen-to-both-sides"
        }
      }
    },
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "direct.chuxubank.top",
            "port": 8443,
            "users": [
              {
                "id": "3a4ffeea-c276-4d30-b3b4-fb152e22d4be",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "tag": "Proxy-quic",
      "streamSettings": {
        "network": "quic",
        "quicSettings": {
          "security": "none",
          "key": "",
          "header": {
            "type": "srtp"
          }
        },
        "security": "tls",
        "tlsSettings": {
          "servername": "chuxubank.top"
        }
      }
    },
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "direct.chuxubank.top",
            "port": 8445,
            "users": [
              {
                "id": "dcd639c1-3413-5af8-fdd4-62ee8bee9fcd",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
              }
            ]
          }
        ]
      },
      "tag": "Proxy-reality",
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "publicKey": "YC2qo1k_HL8KuE7RN758n4uSDEXjWyUirovdXcnCwgs",
          "shortId": "3f4d573ec4ce481c",
          "serverName": "www.microsoft.com",
          "fingerprint": "randomized"
        }
      }
    },
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "direct.chuxubank.top",
            "port": 8446,
            "users": [
              {
                "id": "45d66f5d-2ef5-4477-b9b2-afdcee145c76",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
              }
            ]
          }
        ]
      },
      "tag": "Proxy-xtls",
      "streamSettings": {
        "network": "tcp",
        "security": "tls",
        "tlsSettings": {
          "serverName": "chuxubank.top",
          "fingerprint": "randomized"
        }
      }
    },
    {
      "protocol": "http",
      "tag": "Proxy-http",
      "settings": {
        "servers": [
          {
            "address": "10.29.248.90",
            "port": 80
          }
        ]
      }
    },
    {
      "protocol": "freedom",
      "tag": "Direct"
    },
    {
      "tag": "Block",
      "protocol": "blackhole"
    }
  ]
}
