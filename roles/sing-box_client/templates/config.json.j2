{
  "$schema": "https://gist.githubusercontent.com/artiga033/fea992d95ad44dc8d024b229223b1002/raw/sing-box.schema.json",
  "log": {
    "level": "trace",
    "output": "{{ sing_box_log_dir }}/sing-box.log",
    "timestamp": true
  },
  "dns": {
    "servers": [
      {
        "tag": "google",
        "type": "https",
        "server": "8.8.8.8",
        "detour": "proxy"
      },
      {
        "tag": "ali",
        "type": "https",
        "server": "223.5.5.5"
      },
      {
        "tag": "cf",
        "type": "https",
        "server": "1.1.1.1",
        "detour": "proxy"
      },
      {
        "tag": "ts",
        "type": "tailscale",
        "endpoint": "ts-ep"
      },
      { "type": "local", "tag": "local" }
    ],
    "rules": [
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          { "rule_set": "geosite-google" },
          { "rule_set": "geosite-google-cn" }
        ],
        "server": "google",
        "client_subnet": "114.114.114.114/24"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          { "rule_set": "geosite-geolocation-cn" },
          { "domain": ["{{ xray_env.DOMAIN }}"] },
          { "domain_keyword": ["mirror"] }
        ],
        "server": "ali"
      },
      {
        "rule_set": "geoip-cn",
        "server": "ali"
      },
      {
        "ip_accept_any": true,
        "server": "ts"
      }
    ],
    "strategy": "ipv4_only",
    "independent_cache": true
  },
  "route": {
    "rules": [
      {
        "action": "sniff"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "protocol": "dns"
          },
          {
            "port": 53
          }
        ],
        "action": "hijack-dns"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "ip_cidr": ["100.64.0.0/10", "fd7a:115c:a1e0::/48"]
          },
          {
            "domain_suffix": ["ts.net"]
          }
        ],
        "outbound": "ts-ep"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "port": 853
          },
          {
            "network": "udp",
            "port": 443
          },
          {
            "protocol": "stun"
          }
        ],
        "action": "reject"
      },
      {
        "type": "logical",
        "mode": "or",
        "rules": [
          {
            "network": "icmp"
          },
          {
            "protocol": "ssh"
          },
          {
            "ip_is_private": true
          },
          {
            "rule_set": "geoip-cn"
          },
          {
            "rule_set": "geosite-apple-cn"
          },
          {
            "process_name": [
              "xray",
              "hysteria",
              "fly",
              "Teams",
              "Motrix",
              "Feishu"
            ]
          },
          {
            "process_path_regex": [".*xray"]
          },
          { "domain_keyword": ["mirror"] },
          { "domain_suffix": ["r2.cloudflarestorage.com", "jump.shxzzn.com"] }
        ],
        "outbound": "direct"
      }
    ],
    "rule_set": [
      {
        "type": "remote",
        "tag": "geosite-category-ads-all",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-category-ads-all.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-geolocation-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-geolocation-cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-google",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-google.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-google-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-google@cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-apple-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-apple@cn.srs"
      },
      {
        "type": "remote",
        "tag": "geosite-geolocation-!cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geosite/rule-set/geosite-geolocation-!cn.srs"
      },
      {
        "type": "remote",
        "tag": "geoip-cn",
        "format": "binary",
        "url": "https://raw.githubusercontent.com/SagerNet/sing-geoip/rule-set/geoip-cn.srs"
      }
    ],
    "final": "select",
    "default_domain_resolver": "ali",
    "auto_detect_interface": true
  },
  "inbounds": [
    {
      "type": "tun",
      "tag": "tun-in",
      "address": ["172.18.0.1/30"],
      "auto_route": true,
      "stack": "gvisor",
      "strict_route": true
    }
  ],
  "outbounds": [
    {% if host_env == "iv" %}
    {
      "type": "http",
      "tag": "proxy-iv",
      "server": "proxy.invalley.co",
      "server_port": 8123
    },
    {% endif %}
    {
      "type": "vless",
      "tag": "proxy-self",
      "server": "{{ xray_env.ADDRESS }}",
      "uuid": "{{ xray_env.CLIENT_ID }}",
      "flow": "xtls-rprx-vision",
      "tls": {
        "enabled": true,
        "server_name": "{{ xray_env.REALITY_TARGET }}",
        "utls": {
          "enabled": true
        },
        "reality": {
          "enabled": true,
          "public_key": "{{ xray_env.REALITY_PUBLIC_KEY }}",
          "short_id": "{{ xray_env.REALITY_SHORT_ID }}"
        }
      },
      "server_port": {{ xray_env.REALITY_PORT | int }}
    },
    {
      "type": "selector",
      "tag": "select",
      "outbounds": [
        {% if host_env == "iv" %}
        "proxy-iv",
        {% endif %}
        "proxy-self"
      ],
      "default": "proxy-self",
      "interrupt_exist_connections": false
    },
    {
      "type": "urltest",
      "tag": "proxy",
      "outbounds": [
        {% if host_env == "iv" %}
        "proxy-iv",
        {% endif %}
        "proxy-self"
      ],
      "url": "https://connectivitycheck.gstatic.com/generate_204",
      "interval": "3m",
      "tolerance": 50,
      "idle_timeout": "30m",
      "interrupt_exist_connections": false
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ],
  "endpoints": [
    {
      "type": "tailscale",
      "tag": "ts-ep",
      "auth_key": "{{ sing_box_tailscale_auth_token }}",
      "accept_routes": true,
      "exit_node_allow_lan_access": true,
      "advertise_exit_node": true
    }
  ],
  "experimental": {
    "cache_file": {
      "enabled": true,
      "store_rdrc": true
    },
    "clash_api": {
      "external_controller": "127.0.0.1:9090",
      "access_control_allow_origin": [
        "http://127.0.0.1",
        "http://yacd.haishan.me"
      ],
      "access_control_allow_private_network": true
    }
  }
}
