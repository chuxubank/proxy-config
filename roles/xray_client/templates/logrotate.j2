{{ xray_log_dir }}/stdout.log {
  rotate 3
  yearly
  missingok
  notifempty
  compress
  copytruncate
}

{{ xray_log_dir }}/stderr.log {
  rotate 3
  yearly
  missingok
  notifempty
  compress
  copytruncate
}

{{ xray_log_dir }}/access.log {
  rotate 7
  daily
  missingok
  notifempty
  compress
  copytruncate
}

{{ xray_log_dir }}/error.log {
  rotate 3
  yearly
  missingok
  notifempty
  compress
  copytruncate
}
