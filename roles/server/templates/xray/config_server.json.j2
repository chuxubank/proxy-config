{
  "log": {
    "loglevel": "debug",
    "dnsLog": true
  },
  "stats": {},
  "api": {
    "tag": "api",
    "services": [
      "StatsService"
    ]
  },
  "policy": {
    "levels": {
      "0": {
        "statsUserUplink": true,
        "statsUserDownlink": true
      }
    },
    "system": {
      "statsInboundUplink": true,
      "statsInboundDownlink": true,
      "statsOutboundUplink": true,
      "statsOutboundDownlink": true
    }
  },
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "inboundTag": ["dokodemo-in"],
        "domain": ["{{ xray_env.REALITY_TARGET }}"],
        "outboundTag": "direct",
        "ruleTag": "Xray Reality Client"
      },
      {
        "domain": [
          "geosite:anthropic",
          "geosite:google-scholar",
          "geosite:netflix",
          "geosite:openai",
          "geosite:stripe"
        ],
        "outboundTag": "warp",
        "ruleTag": "Clean IP"
      },
      {
        "domain": ["geosite:geolocation-!cn"],
        "outboundTag": "direct",
        "ruleTag": "Known Site"
      },
      {
        "inboundTag": ["dokodemo-in"],
        "outboundTag": "blocked",
        "ruleTag": "Unknown Client"
      },
      {
        "inboundTag": [
          "api"
        ],
        "outboundTag": "api",
        "ruleTag": "API"
      },
      {
        "ip": ["geoip:cn", "geoip:private"],
        "outboundTag": "blocked",
        "ruleTag": "Private/CN IP"
      }
    ]
  },
  "inbounds": [
    {
      "tag": "dokodemo-in",
      "port": {{ xray_env.REALITY_PORT | int }},
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1",
        "port": 4432,
        "network": "tcp"
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["tls"],
        "routeOnly": true
      }
    },
    {
      "port": {{ xray_env.API_PORT }},
      "tag": "api",
      "protocol": "dokodemo-door",
      "settings": {
        "address": "127.0.0.1"
      }
    },
    {
      "listen": "127.0.0.1",
      "port": 4432,
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "{{ xray_env.CLIENT_ID }}",
            "flow": "xtls-rprx-vision"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "show": false,
          "target": "{{ xray_env.REALITY_TARGET }}:443",
          "serverNames": ["{{ xray_env.REALITY_TARGET }}"],
          "privateKey": "{{ xray_env.REALITY_PRIVATE_KEY }}",
          "shortIds": ["{{ xray_env.REALITY_SHORT_ID }}"]
        }
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "routeOnly": true
      }
    },
    {
      "port": {{ xray_env.XHTTP_PORT }},
      "protocol": "vless",
      "settings": {
        "clients": [
          {
            "id": "{{ xray_env.CLIENT_ID }}"
          }
        ],
        "decryption": "none"
      },
      "streamSettings": {
        "network": "xhttp",
        "xhttpSettings": {
          "path": "{{ xray_env.XHTTP_PATH }}"
        }
      }
    }
  ],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom",
      "settings": {}
    },
    {
      "tag": "warp",
      "protocol": "socks",
      "settings": {
        "servers": [
          {
            "address": "warp",
            "port": 9091
          }
        ]
      }
    },
    {
      "tag": "blocked",
      "protocol": "blackhole",
      "settings": {}
    }
  ]
}
