{% if 'caddy' in proxy_services or 'grafana' in proxy_services or 'magpie' in proxy_services %}
DOMAIN={{ proxy_env.DOMAIN }}
{% endif %}
{% if 'caddy' in proxy_services %}
EMAIL={{ proxy_env.EMAIL }}
CF_API_TOKEN={{ proxy_env.CF_API_TOKEN }}
{% endif %}
{% if 'xray' in proxy_services %}
REALITY_PORT={{ xray_env.REALITY_PORT }}
XHTTP_PORT={{ xray_env.XHTTP_PORT }}
XHTTP_PATH={{ xray_env.XHTTP_PATH }}
API_PORT={{ xray_env.API_PORT }}
{% endif %}
{% if 'grafana' in proxy_services %}
GRAFANA_SUB_DOMAIN={{ monitoring_env.GRAFANA_SUB_DOMAIN }}
GRAFANA_ADMIN_PASSWORD={{ monitoring_env.GRAFANA_ADMIN_PASSWORD }}
{% endif %}
{% if 'prometheus' in proxy_services and 'caddy' in proxy_services %}
PROM_SUB_DOMAIN={{ monitoring_env.PROM_SUB_DOMAIN }}
PROM_USER={{ monitoring_env.PROM_USER }}
PROM_PASSWORD_HASH={{ monitoring_env.PROM_PASSWORD_HASH }}
{% endif %}
{% if 'magpie' in proxy_services %}
MAGPIE_NO_ACCOUNTS={{ '1' if magpie_no_accounts | default(false) | bool else '0' }}
{% endif %}
