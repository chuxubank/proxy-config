{
	email {env.EMAIL}
	servers {
		protocols h1 h2 h3
	}
}

*.{$DOMAIN:localhost} {
	tls {
		dns cloudflare {env.CF_API_TOKEN}
	}
}

{$DOMAIN:localhost} {
	log
	file_server
	@grpc {
		protocol grpc
		path {$XHTTP_PATH}/
	}
	reverse_proxy @grpc h2c://xray:{$XHTTP_PORT}
}

{$RSS_SUB_DOMAIN:rss}.{$DOMAIN:localhost} {
	reverse_proxy http://freshrss
}

{$RSSHUB_SUB_DOMAIN:rsshub}.{$DOMAIN:localhost} {
	reverse_proxy http://rsshub:1200
}
