{
  "log": {
    "loglevel": "debug",
    "dnsLog": true
  },
  "dns": {
    "servers": [
      {
        "address": "223.5.5.5",
        "port": 53,
        "domains": ["geosite:cn"],
        "expectIPs": ["geoip:cn"]
      },
      {
        "address": "8.8.8.8",
        "port": 53,
        "domains": ["geosite:geolocation-!cn"]
      },
      "1.1.1.1",
      "localhost"
    ],
    "queryStrategy": "UseIPv4"
  },
  "routing": {
    "domainStrategy": "IPIfNonMatch",
    "rules": [
      {
        "domain": ["geosite:umeng"],
        "outboundTag": "Direct",
        "ruleTag": "Allowed Ads"
      },
      {
        "domain": ["geosite:category-ads"],
        "outboundTag": "Block",
        "ruleTag": "Blocked Ads"
      },
      {
        "domain": [
          "geosite:apple",
          "geosite:atlassian",
          "geosite:cn",
          "geosite:google@cn",
          "geosite:jetbrains",
          "geosite:logitech",
          "geosite:microsoft@cn",
          "geosite:notion",
          "geosite:steam@cn",
          "domain:teams.microsoft.com",
          "domain:documentfoundation.org",
          "domain:cn.msi.com",
          "domain:ping.pe",
          "domain:bwh88.net",
          "domain:64clouds.com",
          "domain:justmysocks5.net",
          "domain:imwork.net",
          "domain:xiumi.us"
        ],
        "outboundTag": "Direct",
        "ruleTag": "China Domains"
      },
      {
        "domain": ["geosite:category-ai-chat-!cn"],
        "balancerTag": "Proxy-self",
        "ruleTag": "IP Restriction"
      },
      {
        "domain": [
          "geosite:discord",
          "domain:sdkman.io"
        ],
        "balancerTag": "Proxy-self",
        "ruleTag": "Work Banned"
      },
      {
        "domain": ["geosite:geolocation-!cn"],
        "balancerTag": "Proxy",
        "ruleTag": "Known Foreign Site"
      },
      {
        "ip": ["geoip:cn", "geoip:private", "{{ xray_env.ADDRESS }}"],
        "outboundTag": "Direct",
        "ruleTag": "Private/CN IP"
      }
    ],
    "balancers": [
      {
        "tag": "Proxy",
        "selector": ["Proxy"],
        "strategy": {
          "type": "leastPing",
          "settings": {}
        }
      },
      {
        "tag": "Proxy-self",
        "selector": ["Proxy-self"],
        "strategy": {
          "type": "leastPing",
          "settings": {}
        }
      }
    ]
  },
  "inbounds": [
    {
      "port": 10800,
      "listen": "127.0.0.1",
      "protocol": "socks",
      "settings": {
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": ["http", "tls", "quic"],
        "domainsExcluded": ["courier.push.apple.com"],
        "routeOnly": true
      }
    }
  ],
  "outbounds": [
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "{{ xray_env.DOMAIN }}",
            "port": 443,
            "users": [
              {
                "id": "{{ xray_env.CLIENT_ID }}",
                "encryption": "none"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "xhttp",
        "security": "tls",
        "xhttpSettings": {
          "path": "{{ xray_env.XHTTP_PATH }}"
        }
      },
      "tag": "Proxy-self-xhttp"
    },
    {
      "protocol": "vless",
      "settings": {
        "vnext": [
          {
            "address": "{{ xray_env.ADDRESS }}",
            "port": {{ xray_env.REALITY_PORT | int }},
            "users": [
              {
                "id": "{{ xray_env.CLIENT_ID }}",
                "encryption": "none",
                "flow": "xtls-rprx-vision"
              }
            ]
          }
        ]
      },
      "streamSettings": {
        "network": "tcp",
        "security": "reality",
        "realitySettings": {
          "fingerprint": "chrome",
          "serverName": "{{ xray_env.REALITY_TARGET }}",
          "publicKey": "{{ xray_env.REALITY_PUBLIC_KEY }}",
          "spiderX": "",
          "shortId": "{{ xray_env.REALITY_SHORT_ID }}"
        }
      },
      "tag": "Proxy-self-reality"
    },
    {
      "protocol": "freedom",
      "tag": "Direct"
    },
    {
      "tag": "Block",
      "protocol": "blackhole"
    }
  ],
  "observatory": {
    "subjectSelector": ["Proxy"],
    "probeUrl": "https://www.google.com/generate_204",
    "probeInterval": "1m",
    "enableConcurrency": true
  },
  "burstObservatory": {
    "subjectSelector": ["Proxy"],
    "pingConfig": {
      "destination": "https://connectivitycheck.gstatic.com/generate_204",
      "connectivity": "",
      "interval": "5m",
      "sampling": 3,
      "timeout": "30s"
    }
  }
}
